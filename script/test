#!/bin/bash

# This script runs the standard linter/formatter on the project
# It demonstrates how to use the standard gem for code style checking

echo "Running standard linter/formatter on the project..."

# Run standard with the default configuration
if command -v bundle &> /dev/null; then
  bundle exec standardrb
  exit_code=$?
else
  echo "Error: bundle command not found"
  exit_code=1
fi

if [ $exit_code -eq 0 ]; then
  echo "✓ Code style is correct"
else
  echo "✗ Code style issues found"
  echo "To fix issues automatically, run: bundle exec standardrb --fix"
fi

exit $exit_code
